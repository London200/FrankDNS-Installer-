#!/bin/bash
set -euo pipefail

# ==============================================================================
#  FRANKDNS SUITE v9.5 - PRECISION GUARD 🎯
#  Javítva: A "SafeGuard" mostantól megkülönbözteti a fontos domaineket
#  a reklámoktól. (Pl. a google.com védett, de az ads.google.com BLOKKOLVA marad!)
# ==============================================================================

# --- KONFIGURÁCIÓ ---
SERVER_IP="192.168.3.143"
PORT="8000"
API_URL="http://${SERVER_IP}:${PORT}/api"

# Útvonalak
BASE_DIR="/home/robot_36"
WORK_DIR="$BASE_DIR/frankdns-banyasz"
LIST_FILE="$WORK_DIR/extracted_domains.txt"
TEMP_FILE="$WORK_DIR/temp_raw.txt"
NEW_BATCH="$WORK_DIR/new_batch.txt"
SAFE_EXACT="$WORK_DIR/safe_exact.txt"
SAFE_PATTERN="$WORK_DIR/safe_pattern.txt"
DELETE_QUEUE="$WORK_DIR/delete_queue.txt"

# Színek
R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
B='\033[0;34m'
C='\033[0;36m'
W='\033[1m'
N='\033[0m'

# --- RENDSZER ELLENŐRZÉS ---
setup() {
    mkdir -p "$WORK_DIR"
    if [ ! -w "$WORK_DIR" ]; then
        echo -e "${Y}Jogosultság javítása...${N}"
        sudo chown -R $USER:$USER "$BASE_DIR"
        sudo chmod -R 755 "$BASE_DIR"
    fi
    if ! command -v jq &> /dev/null; then sudo apt-get install -y jq >/dev/null 2>&1 || true; fi
    if ! command -v dig &> /dev/null; then sudo apt-get install -y dnsutils >/dev/null 2>&1 || true; fi
}

# --- PRECÍZIÓS VÉDELEM (ÚJ MOTOR) ---
apply_precision_safeguard() {
    echo -e "${C}🛡️  Precíziós SafeGuard futtatása...${N}"
    
    # 1. CSOPORT: PONTOS EGYEZÉS (EXACT MATCH)
    # Ezeket védjük, de az aldomainjeiket (pl. ads.google.com) NEM!
    cat <<EOF > "$SAFE_EXACT"
google.com
www.google.com
google.hu
www.google.hu
facebook.com
www.facebook.com
m.facebook.com
instagram.com
www.instagram.com
youtube.com
www.youtube.com
m.youtube.com
gmail.com
www.gmail.com
accounts.google.com
accounts.youtube.com
github.com
www.github.com
messenger.com
www.messenger.com
EOF

    # 2. CSOPORT: TARTALOM SZERVEREK (PATTERN MATCH)
    # Ezek a képek/videók szerverei, ezeket engedjük (nincs rajtuk reklámkód)
    cat <<EOF > "$SAFE_PATTERN"
fbcdn.net
cdninstagram.com
googlevideo.com
gstatic.com
githubusercontent.com
ytimg.com
ggpht.com
EOF

    # --- Futtatás 1: Pontos egyezés kivétele ---
    # A -x kapcsoló miatt csak a teljes soros egyezést veszi ki.
    # Tehát a 'google.com' kimegy, de az 'adservice.google.com' MARAD!
    if grep -Fxf "$SAFE_EXACT" "$NEW_BATCH" > /dev/null; then
        echo -e "${Y}   [1/2] Főoldalak védelme (Reklámok maradnak)...${N}"
        grep -Fxf "$SAFE_EXACT" "$NEW_BATCH" | while read -r line; do
            echo -e "       ✅ Megmentve (Exact): $line"
        done
        grep -vFxf "$SAFE_EXACT" "$NEW_BATCH" > "${NEW_BATCH}.tmp" && mv "${NEW_BATCH}.tmp" "$NEW_BATCH"
    fi

    # --- Futtatás 2: Tartalom szerverek kivétele ---
    if grep -Ff "$SAFE_PATTERN" "$NEW_BATCH" > /dev/null; then
        echo -e "${Y}   [2/2] Képek és Videók szervereinek védelme...${N}"
        grep -Ff "$SAFE_PATTERN" "$NEW_BATCH" | while read -r line; do
            # Csak az első párat írjuk ki, ne szemetelje tele a képernyőt
            count=$(grep -c "$line" "$NEW_BATCH" || true)
        done | head -3
        echo "       (és a többi tartalom szerver...)"
        
        grep -vFf "$SAFE_PATTERN" "$NEW_BATCH" > "${NEW_BATCH}.tmp" && mv "${NEW_BATCH}.tmp" "$NEW_BATCH"
    fi

    rm -f "$SAFE_EXACT" "$SAFE_PATTERN"
    echo -e "${G}✅ SafeGuard Kész. A reklám domainek (pl. ads, tracking) blokkolva maradtak!${N}"
}

# --- BÁNYÁSZ MOTOR (AUTO-CLEAN) ---
scrape() {
    clear
    echo -e "${C}=== TÖMEGES URL FELDOLGOZÓ (Tiszta lap) ===${N}"
    echo -e "${Y}1. Másold be a linkeket.${N}"
    echo -e "${Y}2. Nyomj egy ÜRES ENTER-t az indításhoz.${N}"
    echo -e "${R}(Figyelem: Az előző lista automatikusan törlődik!)${N}"
    echo ""

    raw_input=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && break
        raw_input="$raw_input $line"
    done

    if [[ -z "$raw_input" ]]; then return; fi

    echo ""
    echo -e "${B}🚀 Feldolgozás indítása...${N}"

    if [[ -f "$LIST_FILE" ]]; then
        rm "$LIST_FILE"
        echo -e "${Y}♻️  Előző lista törölve. Tiszta lappal indulunk.${N}"
    fi

    for url in $raw_input; do
        if [[ "$url" != http* ]]; then continue; fi

        echo -e "   ⬇️  Letöltés: $url"
        content=$(curl -s --connect-timeout 8 -L "$url")
        if [[ -z "$content" ]]; then 
            echo -e "${R}      Hiba: Nem elérhető.${N}"
            continue 
        fi
        
        echo "$content" > "$TEMP_FILE"
        
        js_links=$(echo "$content" | grep -oE 'src="[^"]+\.js"' | cut -d'"' -f2)
        if [[ -n "$js_links" ]]; then
            for js in $js_links; do
                if [[ "$js" == http* ]]; then full="$js"; else
                    base=$(echo "$url" | sed 's|/$||'); clean=$(echo "$js" | sed 's|^/||'); full="${base}/${clean}"
                fi
                curl -s "$full" >> "$TEMP_FILE" || true
            done
        fi

        grep -oE '([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}' "$TEMP_FILE" | sort -u > "$WORK_DIR/raw.txt"
        
        grep -vE '\.(html|png|jpg|css|js|xml|php|ico|svg|woff)$' "$WORK_DIR/raw.txt" | \
        grep -vE '^(e\.|t\.|n\.|m\.|f\.|this\.|window\.|console\.)' | \
        grep -E '\.(com|net|org|hu|eu|info|io|co|uk|de|ru|cn|biz|top|xyz|site|online|tech|store|shop)$' > "$NEW_BATCH"

        source_domain=$(echo "$url" | awk -F/ '{print $3}')
        if [[ -n "$source_domain" ]]; then 
            grep -vF "$source_domain" "$NEW_BATCH" > "${NEW_BATCH}.tmp" && mv "${NEW_BATCH}.tmp" "$NEW_BATCH"
        fi

        # --- ITT A JAVÍTOTT VÉDELEM ---
        apply_precision_safeguard
        # ------------------------------

        if [[ -f "$LIST_FILE" ]]; then
            cat "$LIST_FILE" "$NEW_BATCH" | sort -u > "${LIST_FILE}.merged"
            mv "${LIST_FILE}.merged" "$LIST_FILE"
        else
            mv "$NEW_BATCH" "$LIST_FILE"
        fi
    done

    if [[ -f "$LIST_FILE" ]]; then
        new_total=$(wc -l < "$LIST_FILE")
        echo ""
        echo -e "${G}✅ MINDEN KÉSZ!${N}"
        echo -e "Az új, szűrt lista mérete: ${W}$new_total${N} db domain."
        
        echo ""
        echo -e "${Y}Szeretnéd manuálisan is átnézni/törölni? (i/n)${N}"
        read -rp "> " ask
        if [[ "$ask" == "i" ]]; then advanced_search_filter; fi
    else
        echo -e "${R}Nem lett semmi letöltve.${N}"
    fi
}

# --- KERESŐ ÉS TÖRLŐ FUNKCIÓ ---
advanced_search_filter() {
    clear
    if [[ ! -f "$LIST_FILE" ]]; then echo -e "${R}Nincs lista!${N}"; sleep 2; return; fi

    while true; do
        total=$(wc -l < "$LIST_FILE")
        echo ""
        echo -e "${C}=== HELYI LISTA SZERKESZTÉSE ===${N}"
        echo -e "Adatbázis: ${W}$total${N} db."
        echo -e "${Y}Mit szeretnél törölni belőle? (Pl: tiktok snapchat)${N}"
        echo -e "Nyomj ENTER-t a kilépéshez."
        read -rp "Keresés > " query

        if [[ -z "$query" ]]; then break; fi

        regex_query=$(echo "$query" | tr -s ' ' '|')
        mapfile -t matches < <(grep -E "$regex_query" "$LIST_FILE" | head -30)
        match_count=$(grep -Ec "$regex_query" "$LIST_FILE" || true)

        if [[ "$match_count" -eq 0 ]]; then
            echo -e "${R}Nincs találat.${N}"
            continue
        fi

        echo -e "${B}Találatok ($match_count db):${N}"
        echo "--------------------------------"
        i=1
        for m in "${matches[@]}"; do
            echo -e " [${W}$i${N}] $m"
            ((i++))
        done
        if [[ "$match_count" -gt 30 ]]; then echo "... és még $((match_count - 30)) db"; fi
        echo "--------------------------------"
        
        echo -e "${Y}Választás:${N}"
        echo -e " - Számok (pl: ${W}1 3 5${N}) -> Csak ezeket törlöm"
        echo -e " - ${R}all${N} -> MINDEN találatot törlök"
        echo -e " - ENTER -> Mégse"
        read -rp "> " selection

        if [[ -z "$selection" ]]; then continue; fi

        if [[ "$selection" == "all" ]]; then
            grep -vE "$regex_query" "$LIST_FILE" > "${LIST_FILE}.tmp" && mv "${LIST_FILE}.tmp" "$LIST_FILE"
            echo -e "${G}✅ Minden törölve!${N}"
        else
            rm -f "$DELETE_QUEUE"
            for id in $selection; do
                if [[ "$id" =~ ^[0-9]+$ ]] && [ "$id" -le "${#matches[@]}" ] && [ "$id" -gt 0 ]; then
                    domain_to_del="${matches[$((id-1))]}"
                    echo "$domain_to_del" >> "$DELETE_QUEUE"
                fi
            done
            if [[ -f "$DELETE_QUEUE" ]]; then
                grep -vFf "$DELETE_QUEUE" "$LIST_FILE" > "${LIST_FILE}.tmp" && mv "${LIST_FILE}.tmp" "$LIST_FILE"
                echo -e "${G}✅ Kijelölt domainek törölve!${N}"
                rm "$DELETE_QUEUE"
            fi
        fi
    done
}

# --- SZERVER MŰVELETEK ---
upload_menu() {
    if [[ ! -f "$LIST_FILE" ]]; then echo -e "${R}Nincs mit feltölteni!${N}"; sleep 1; return; fi
    count=$(wc -l < "$LIST_FILE")
    
    echo ""
    echo -e "${C}=== FELTÖLTÉS A SZERVERRE ===${N}"
    echo -e "Feltöltendő: ${W}$count db${N} domain."
    echo -e " [1] ${R}🚫 Blokkolás (Feketelista)${N}"
    echo -e " [2] ${G}✅ Engedélyezés (Fehérlista)${N}"
    echo -e " [0] Mégse"
    read -rp "> " c
    
    [[ "$c" == "0" ]] && return
    type="blacklist"
    [[ "$c" == "2" ]] && type="whitelist"
    
    echo -e "${B}Küldés...${N}"
    cfg=$(curl -s "${API_URL}/config")
    curr=$(echo "$cfg" | jq -r ".$type // []")
    
    while read -r d; do curr=$(echo "$curr" | jq --arg d "$d" '. + [$d] | unique'); done < "$LIST_FILE"
    
    new_cfg=$(echo "$cfg" | jq --argjson l "$curr" ".$type = \$l")
    curl -s -X POST "${API_URL}/config" -H "Content-Type: application/json" -d "$new_cfg" > /dev/null
    
    echo -e "${G}Siker! Feltöltve.${N}"
    echo -e "${Y}Ne felejts el Frissíteni (7-es gomb)!${N}"
    read -rp "Enter..."
}

delete_from_server() {
    clear
    echo -e "${R}=== VISSZAVONÁS (TÖRLÉS A SZERVERRŐL) ===${N}"
    if [[ ! -f "$LIST_FILE" ]]; then echo -e "${R}Nincs lista betöltve!${N}"; sleep 2; return; fi
    
    count=$(wc -l < "$LIST_FILE")
    echo -e "A listában lévő ${W}$count db${N} domaint fogom törölni a szerverről."
    echo ""
    echo -e " [1] ${R}🚫 Feketelistáról törlés${N}"
    echo -e " [2] ${G}✅ Fehérlistáról törlés${N}"
    echo -e " [0] Mégse"
    read -rp "> " c
    
    [[ "$c" == "0" ]] && return
    type="blacklist"
    [[ "$c" == "2" ]] && type="whitelist"
    
    echo -e "${B}Törlés folyamatban...${N}"
    cfg=$(curl -s "${API_URL}/config")
    curr=$(echo "$cfg" | jq -r ".$type // []")
    
    while read -r d; do curr=$(echo "$curr" | jq --arg d "$d" '. - [$d]'); done < "$LIST_FILE"
    
    new_cfg=$(echo "$cfg" | jq --argjson l "$curr" ".$type = \$l")
    curl -s -X POST "${API_URL}/config" -H "Content-Type: application/json" -d "$new_cfg" > /dev/null
    
    echo -e "${G}Kész! Törölve a szerverről.${N}"
    read -rp "Enter..."
}

update_server() {
    echo -e "${B}Szerver frissítése...${N}"
    curl -s -X POST "${API_URL}/update_blocklists" > /dev/null
    echo -e "${G}Frissítés elindult!${N}"
    sleep 1
}

view_list() {
    clear
    if [[ -f "$LIST_FILE" ]]; then
        count=$(wc -l < "$LIST_FILE")
        echo -e "${C}Lista tartalma ($count db):${N}"
        echo -e "${Y}Görgess a nyilakkal. Kilépéshez nyomd meg a 'q' betűt!${N}"
        echo "------------------------------------------------"
        read -rp "Nyomj ENTER-t a lista megnyitásához..."
        less -e -P "--- VÉGE (Nyomj Q-t a kilépéshez!) ---" "$LIST_FILE"
        echo -e "${G}Kiléptél a listából.${N}"
    else
        echo -e "${R}A lista üres.${N}"
    fi
    read -rp "Nyomj ENTER-t a menübe való visszalépéshez..."
}

reset_folder() {
    rm -rf "$WORK_DIR"/*
    echo "Törölve."
    sleep 1
}

# --- FŐMENÜ ---
while true; do
    clear
    echo -e "${C}╔═══════════════════════════════════════╗${N}"
    echo -e "${C}║${N}  ${W}FRANKDNS v9.5 - PRECISION GUARD${N}      ${C}║${N}"
    echo -e "${C}╚═══════════════════════════════════════╝${N}"
    echo ""
    echo -e "${W}--- BÁNYÁSZAT ---${N}"
    echo -e " [1] ${G}🌐 URL-ek Letöltése (SafeGuard aktív)${N}"
    echo -e " [2] 📋 Lista megtekintése"
    echo -e " [3] 📂 Mappa megnyitása"
    echo -e " [4] 🗑️  Helyi fájlok törlése (Reset)"
    echo ""
    echo -e "${W}--- SZERKESZTÉS & FELTÖLTÉS ---${N}"
    echo -e " [5] 🔍 ${Y}KERESÉS ÉS TÖRLÉS (Manuális)${N}"
    echo -e " [6] ☁️  FELTÖLTÉS A SZERVERRE"
    echo ""
    echo -e "${W}--- SZERVER KARBANTARTÁS ---${N}"
    echo -e " [7] 🔄 ${C}Szerver Frissítése (Update)${N}"
    echo -e " [8] 🗑️  Csak a fájl törlése"
    echo -e " [9] ${R}🔥 TÖRLÉS A SZERVERRŐL (Visszavonás)${N}"
    echo ""
    echo -e " [0] Kilépés"
    echo ""
    read -rp "Választás: " opt

    case "$opt" in
        1) scrape ;;
        2) view_list ;;
        3) ls -lh "$WORK_DIR"; read -rp "Enter..." ;;
        4) reset_folder ;;
        5) advanced_search_filter ;;
        6) upload_menu ;;
        7) update_server ;;
        8) rm "$LIST_FILE"; echo "Törölve."; sleep 1 ;;
        9) delete_from_server ;;
        0) exit 0 ;;
    esac
done
